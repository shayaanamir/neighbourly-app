rules_version = '2';

// Neighbourly security rules (Cloud Firestore, free Spark plan).
//
// The app is a client-only prototype, so these rules are the real access control:
// a modified app or a script can send any request, and only these rules stop it.
// Publish them in the Firebase console (Firestore -> Rules) after every change.
//
// Phase 9 covers `users` and `listings`. Phase 10 adds `conversations` and `messages`.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------- users
    // A small public profile so people can see who they are talking to.
    // Emails are never stored here.
    match /users/{uid} {
      allow read: if signedIn();

      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40;

      allow delete: if isUser(uid);
    }

    // ------------------------------------------------------------- listings
    function validListing(data) {
      return data.keys().hasOnly([
          'title', 'description', 'category', 'mode', 'priceMinor', 'condition',
          'photoIDs', 'latitude', 'longitude', 'areaName', 'sellerID', 'sellerName',
          'createdAt', 'thumbnail'
        ])
        && data.keys().hasAll([
          'title', 'category', 'mode', 'condition', 'photoIDs', 'sellerID',
          'sellerName', 'createdAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.get('description', '') is string && data.get('description', '').size() <= 1000
        && data.category in ['electronics', 'books', 'furniture', 'clothing', 'home', 'sports', 'toys', 'other']
        && data.mode in ['sell', 'exchange', 'donate']
        && data.condition in ['new', 'likeNew', 'good', 'fair']
        // Sell listings need a non-negative whole-paise price; others must not have one.
        && (data.mode == 'sell'
              ? (data.priceMinor is int && data.priceMinor >= 0 && data.priceMinor <= 100000000)
              : !('priceMinor' in data))
        && data.photoIDs is list && data.photoIDs.size() <= 5
        && data.sellerID is string
        && data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80
        && data.createdAt is timestamp
        // Coordinates come as a valid pair or not at all.
        && (('latitude' in data) == ('longitude' in data))
        && (!('latitude' in data)
              || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90
                  && data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
        && (!('areaName' in data) || (data.areaName is string && data.areaName.size() <= 80))
        && (!('thumbnail' in data) || (data.thumbnail is bytes && data.thumbnail.size() <= 40000));
    }

    match /listings/{listingId} {
      // Anyone, including guests, can browse.
      allow read: if true;

      // You can only post as yourself.
      allow create: if signedIn()
        && request.resource.data.sellerID == request.auth.uid
        && validListing(request.resource.data);

      // Only the owner can change or remove it, and cannot hand it to someone else
      // or rewrite when it was posted.
      allow update: if isUser(resource.data.sellerID)
        && request.resource.data.sellerID == resource.data.sellerID
        && request.resource.data.createdAt == resource.data.createdAt
        && validListing(request.resource.data);

      allow delete: if isUser(resource.data.sellerID);

      // Full-size photos (about 150 KB each) live in documents because Cloud Storage
      // needs a billing plan. Each carries its uploader so rules don't depend on the
      // listing document existing yet (photos are uploaded first).
      match /photos/{photoId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['data', 'order', 'ownerID'])
          && request.resource.data.ownerID == request.auth.uid
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 300000
          && request.resource.data.order is int;

        allow update: if isUser(resource.data.ownerID)
          && request.resource.data.ownerID == resource.data.ownerID
          && request.resource.data.keys().hasOnly(['data', 'order', 'ownerID'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 300000;

        allow delete: if isUser(resource.data.ownerID);
      }
    }

    // -------------------------------------------------------- conversations
    // One conversation per buyer per listing, with the ID "{listingID}_{buyerID}".
    // Only its two participants can read it; nobody can read someone else's chat.
    match /conversations/{conversationId} {

      // `resource == null` lets a buyer check whether the conversation already exists
      // before creating it; once it exists only participants can read it.
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participantIDs);

      // Listing queries must be limited to the caller's own conversations
      // (the app asks for participantIDs array-contains its own UID).
      allow list: if signedIn() && request.auth.uid in resource.data.participantIDs;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
            'listingID', 'listingTitle', 'sellerID', 'buyerID', 'sellerName', 'buyerName',
            'participantIDs', 'readAt'
          ])
        && request.resource.data.keys().hasAll([
            'listingID', 'listingTitle', 'sellerID', 'buyerID', 'sellerName', 'buyerName',
            'participantIDs'
          ])
        // You can only start a chat as the buyer, never with yourself.
        && request.resource.data.buyerID == request.auth.uid
        && request.resource.data.sellerID != request.resource.data.buyerID
        && request.resource.data.participantIDs.size() == 2
        && request.resource.data.participantIDs.hasOnly([
            request.resource.data.sellerID, request.resource.data.buyerID
          ])
        && conversationId == request.resource.data.listingID + '_' + request.resource.data.buyerID
        // The "seller" must really be the listing's owner.
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingID)).data.sellerID
            == request.resource.data.sellerID
        && request.resource.data.listingTitle is string && request.resource.data.listingTitle.size() <= 80
        && request.resource.data.sellerName is string && request.resource.data.sellerName.size() <= 80
        && request.resource.data.buyerName is string && request.resource.data.buyerName.size() <= 80;

      // Participants may only touch the "last message" summary and their own read marker.
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIDs
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessageText', 'lastMessageAt', 'lastMessageSenderID', 'readAt'])
        // A new summary must come from the person sending it, stamped with server time.
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['lastMessageText', 'lastMessageAt', 'lastMessageSenderID'])
            || (request.resource.data.lastMessageSenderID == request.auth.uid
                && request.resource.data.lastMessageAt == request.time
                && request.resource.data.lastMessageText is string
                && request.resource.data.lastMessageText.size() >= 1
                && request.resource.data.lastMessageText.size() <= 1000))
        // You can only move your own read marker.
        && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys()
            .hasOnly([request.auth.uid]);

      allow delete: if false;

      // ------------------------------------------------------------ messages
      // Messages are immutable: no edits and no deletes.
      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if signedIn() && request.auth.uid in conversation().participantIDs;

        allow create: if signedIn()
          && request.auth.uid in conversation().participantIDs
          && request.resource.data.keys().hasOnly(['senderID', 'text', 'createdAt'])
          // You can only send as yourself, with the server's clock.
          && request.resource.data.senderID == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // Everything else stays closed until a rule above opens it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
